IMPLEMENTATION MODULE R;
FROM SYSTEM IMPORT ADDRESS;
TYPE RA = RECORD v: INTEGER END;
     A = POINTER TO RA;
     RB = RECORD w: INTEGER END;
     B = POINTER TO RB;
PROCEDURE MakeA(): A;
VAR p: A;
BEGIN NEW(p); p^.v := 11; RETURN p END MakeA;
PROCEDURE MakeB(): B;
VAR p: B;
BEGIN NEW(p); p^.w := 22; RETURN p END MakeB;
PROCEDURE Fill(VAR h: Holder);
BEGIN h.x := MakeA(); h.n := 1 END Fill;
PROCEDURE Val(h: Holder): INTEGER;
BEGIN RETURN h.x^.v + h.n END Val;
PROCEDURE Raw(a: A): ADDRESS;
BEGIN RETURN a END Raw;
END R.
